#!/bin/sh
# NorthStar pre-commit: copy lint on staged site files; token lint on CSS; the fit probe when CSS or components change;
# the behavior check when component behavior or the dashboards change.
# Enable once per clone: git config core.hooksPath tools/hooks
cd "$(git rev-parse --show-toplevel)" || exit 1
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

sitefiles=$(echo "$staged" | grep -E '^(index\.html|js/.*\.js)$')
if [ -n "$sitefiles" ]; then
  node tools/copy-lint.mjs $sitefiles || { echo "Commit blocked by copy lint."; exit 1; }
fi

if echo "$staged" | grep -qE '^css/'; then
  node tools/token-lint.mjs > /dev/null || { echo "Commit blocked by token lint. Run: node tools/token-lint.mjs --list"; exit 1; }
fi

if echo "$staged" | grep -qE '^(css/|js/components\.js|js/charts\.js|tools/fit-probe)'; then
  node tools/fit-probe.mjs > /dev/null
  code=$?
  if [ "$code" -eq 1 ]; then echo "Commit blocked by the fit probe. Run: node tools/fit-probe.mjs"; exit 1; fi
  [ "$code" -eq 2 ] && echo "Fit probe skipped (no Chrome found). Run node tools/fit-probe.mjs before pushing."
fi

# Behavior check: combobox, palette, dropdown, toasts, modal, tabs, table, folded routes and the eight dashboards.
if echo "$staged" | grep -qE '^(css/components\.css|js/(ui|components)\.js|dashboards/live/|tools/behavior-check)'; then
  node tools/behavior-check.mjs > /tmp/ns-behavior.log 2>&1
  code=$?
  if [ "$code" -eq 1 ]; then cat /tmp/ns-behavior.log; echo "Commit blocked by the behavior check. Run: node tools/behavior-check.mjs"; exit 1; fi
  [ "$code" -eq 2 ] && echo "Behavior check skipped (no Chrome found). Run node tools/behavior-check.mjs before pushing."
fi

# Accessibility check: text contrast and accessible names in dark and light when colors or markup change.
if echo "$staged" | grep -qE '^(css/(tokens|components)\.css|js/components\.js|dashboards/live/|tools/a11y-check)'; then
  node tools/a11y-check.mjs > /tmp/ns-a11y.log 2>&1
  code=$?
  if [ "$code" -eq 1 ]; then cat /tmp/ns-a11y.log; echo "Commit blocked by the a11y check. Run: node tools/a11y-check.mjs"; exit 1; fi
  [ "$code" -eq 2 ] && echo "A11y check skipped (no Chrome found). Run node tools/a11y-check.mjs before pushing."
fi

# Agent export: regenerate llms.txt and agent/ when the catalog, tokens or page registry change, and stage the result.
if echo "$staged" | grep -qE '^(css/tokens\.css|js/(components|charts|pages|guides|ui)\.js|tools/agent-export)'; then
  node tools/agent-export.mjs > /dev/null && git add llms.txt agent/ || echo "Agent export skipped. Run node tools/agent-export.mjs before pushing."
fi
exit 0
