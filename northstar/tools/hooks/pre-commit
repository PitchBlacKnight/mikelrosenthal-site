#!/bin/sh
# NorthStar pre-commit. Copy lint first (fast), then only the checks the staged files touch, run in
# parallel by tools/check-all.mjs: token lint and drift, fit probe, behavior, accessibility and visual.
# Before publishing, run everything (including the online Figma drift check): node tools/check-all.mjs
# Enable once per clone: git config core.hooksPath tools/hooks
cd "$(git rev-parse --show-toplevel)" || exit 1
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

sitefiles=$(echo "$staged" | grep -E '^(index\.html|js/.*\.js)$')
if [ -n "$sitefiles" ]; then
  node tools/copy-lint.mjs $sitefiles || { echo "Commit blocked by copy lint."; exit 1; }
fi

checks=""
has() { echo "$staged" | grep -qE "$1"; }
has '^css/' && checks="$checks tokens"
has '^(css/|tools/style-lint|tokens/style-allow)' && checks="$checks style"
has '^(css/tokens\.css|tokens/)' && checks="$checks drift"
has '^(css/|js/components\.js|js/charts\.js|tools/fit-probe)' && checks="$checks fit"
has '^(css/components\.css|js/(ui|components)\.js|dashboards/live/|tools/behavior-check)' && checks="$checks behavior"
has '^(css/(tokens|components)\.css|js/components\.js|dashboards/live/|tools/a11y-check)' && checks="$checks a11y"
has '^(css/|js/(ui|components|charts|viz)\.js|dashboards/live/|tests/visual/baseline/|tools/visual-)' && checks="$checks visual"
has '^(css/components\.css|dashboards/live/|dashboards/app/src/kit/|tools/parity-)' && checks="$checks parity"
has '^(js/(charts|widgets|dashboards|viz|pages|components)\.js|dashboards/[^/]+\.html|dashboards/live/|tools/chart-check)' && checks="$checks charts"

if [ -n "$checks" ]; then
  node tools/check-all.mjs $checks || { echo "Commit blocked. Fix the failures above (an intended visual change: node tools/visual-check.mjs --update)."; exit 1; }
fi

# React kit: regenerate js/react-kit-data.js when the kit or its examples change, and stage it.
if has '^(dashboards/app/src/kit/|tools/react-kit-export)'; then
  node tools/react-kit-export.mjs > /dev/null && git add js/react-kit-data.js || { echo "React kit export failed. Run node tools/react-kit-export.mjs"; exit 1; }
fi

# Agent export: regenerate llms.txt and agent/ when the catalog, tokens or page registry change, and stage the result.
if has '^(css/tokens\.css|js/(components|charts|pages|guides|ui|react-kit-data|react-page)\.js|dashboards/app/src/kit/|tools/agent-export)'; then
  node tools/agent-export.mjs > /dev/null && git add llms.txt agent/ || echo "Agent export skipped. Run node tools/agent-export.mjs before pushing."
fi
exit 0
